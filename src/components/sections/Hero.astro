---
interface Props {
  site: {
    name: string;
    tagline: string;
    logoUrl: string;
  };
}
const { site } = Astro.props;
---

<section id="inicio" class="relative text-white overflow-hidden flex flex-col items-center justify-center bg-[var(--color-bg)]">
  <div class="dot-grid" aria-hidden="true"></div>
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(20,158,201,0.12) 0%, transparent 70%);" aria-hidden="true"></div>

  <div class="relative w-full max-w-4xl mx-auto px-4 md:px-8 pt-24 pb-10 md:pt-28 md:pb-14 text-center flex flex-col items-center">
    {/* Portada compacta (media pantalla) para que los accesos rápidos asomen sin deslizar. */}
    {/* Logo oficial en negativo (Kit de marca): sin caja, brillo ni recolor; mínimo 100 px de ancho. */}
    <img src={site.logoUrl} alt="Aviazion Group" width="2526" height="1325" class="mb-6 w-36 md:w-48 h-auto" />

    <h1 class="text-4xl md:text-5xl font-bold leading-[1.05] mb-4">{site.name}</h1>

    <p class="text-[var(--color-muted)] text-base md:text-lg mb-6 max-w-[44ch]">{site.tagline}</p>

    <div class="flex flex-col sm:flex-row gap-3 justify-center w-full sm:w-auto max-w-xs sm:max-w-none">
      <a href="#accesos" class="btn btn-primary px-8">Ver accesos rápidos</a>
      <a href="#calculadoras" class="btn btn-ghost px-8">Ir a calculadoras</a>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, rgba(20,158,201,0.5), transparent);" aria-hidden="true"></div>
</section>
