---
import OvertimeCalc from '../calculators/OvertimeCalc.astro';
import VacationCalc from '../calculators/VacationCalc.astro';
import ThirteenthCalc from '../calculators/ThirteenthCalc.astro';
import LiquidationCalc from '../calculators/LiquidationCalc.astro';

const calcs = [
  { id: 'sobretiempo', label: 'Sobretiempos', hint: 'Horas extra según jornada, recargo, día de descanso y feriado.', Panel: OvertimeCalc },
  { id: 'vacaciones', label: 'Vacaciones', hint: 'Días y pago según los meses trabajados.', Panel: VacationCalc },
  { id: 'decimo', label: 'Décimo Tercer Mes', hint: 'Monto de cada una de las tres cuotas.', Panel: ThirteenthCalc },
  { id: 'liquidacion', label: 'Liquidación', hint: 'Estimación de prima, vacaciones, décimo y preaviso.', Panel: LiquidationCalc },
];
---

<section id="calculadoras" aria-labelledby="calculadoras-titulo" class="py-24 px-4 md:px-8 bg-[var(--color-bg)]">
  <div class="max-w-4xl mx-auto">
    <div class="mb-12 text-center">
      <span class="eyebrow">Herramientas</span>
      <h2 id="calculadoras-titulo" class="text-4xl font-bold text-[var(--color-text)] mb-3">Calculadoras laborales</h2>
      <p class="text-[var(--color-muted)] max-w-[52ch] mx-auto">Cálculos basados en la legislación laboral vigente de Panamá — jornada 6×1 / 208 h mensuales. Abre la que necesites.</p>
    </div>

    {/* Acordeón: todas cerradas al cargar; se abre una a la vez. Lo escrito en una calculadora
        se conserva aunque la cierres (x-show solo oculta). */}
    <div
      x-data="accordion"
      class="rounded-2xl overflow-hidden bg-[var(--color-surface)] border border-[var(--color-border)] divide-y divide-[var(--color-border)]"
    >
      {calcs.map((c) => (
        <div>
          <h3>
            <button
              type="button"
              id={`calc-btn-${c.id}`}
              aria-controls={`calc-panel-${c.id}`}
              aria-expanded="false"
              x-bind:aria-expanded={`expanded('${c.id}')`}
              x-on:click={`toggle('${c.id}')`}
              x-bind:class={`isOpen('${c.id}') ? 'bg-[rgba(20,158,201,0.12)]' : 'hover:bg-[rgba(20,158,201,0.06)]'`}
              class="group w-full flex items-center gap-4 px-4 sm:px-6 py-4 text-left transition-colors duration-200 -outline-offset-2"
            >
              <span class="flex-1 min-w-0">
                <span class="block font-semibold text-[var(--color-text)] group-hover:text-white">{c.label}</span>
                <span class="block text-sm text-[var(--color-muted)]">{c.hint}</span>
              </span>
              <svg
                x-bind:class={`isOpen('${c.id}') ? 'rotate-180' : ''`}
                class="w-5 h-5 flex-shrink-0 transition-transform duration-200 text-[var(--color-primary-2)]"
                fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </h3>
          <div
            id={`calc-panel-${c.id}`}
            role="region"
            aria-labelledby={`calc-btn-${c.id}`}
            x-show={`isOpen('${c.id}')`}
            class="p-4 sm:p-6 md:p-8 border-t border-[var(--color-border)]"
            style="display:none;"
          >
            <c.Panel />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
