---
import { OVERTIME_GROUPS, formatFactor } from '../../lib/calculations';
---

<div x-data="overtimeCalc" class="space-y-6">
  <p class="calc-note">
    Ley 44 de 1995, Art. 26 — Jornada <strong>6×1 · Base 208 h/mes</strong> (26 días × 8 h). El recargo ×1.75 aplica desde la 3.ª hora diaria O la 9.ª hora semanal de sobretiempo.
  </p>

  <div class="max-w-xs">
    <label class="field-label" for="ot-salario">Salario mensual (B/.)</label>
    <input id="ot-salario" x-model="salario" type="number" inputmode="decimal" min="0" placeholder="Ej: 1000" class="field" aria-describedby="ot-salario-hora" />
    <p id="ot-salario-hora" class="text-xs text-[var(--color-muted)] mt-1">
      Salario/hora: <strong class="text-[var(--color-text)]" x-text="salarioHora > 0 ? 'B/. ' + salarioHora.toFixed(4) : '—'">—</strong>
      <span class="text-[var(--color-accent-text)] font-medium"> (÷ 208 h — jornada 6×1)</span>
    </p>
  </div>

  <div class="overflow-x-auto -mx-2 px-2" tabindex="0" role="region" aria-label="Tabla de tipos de sobretiempo">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="text-left">
          <th scope="col" class="px-2 sm:px-3 py-2 font-semibold text-[var(--color-text)] border-b border-[var(--color-border)]">Tipo de Sobretiempo</th>
          <th scope="col" class="px-2 sm:px-3 py-2 font-semibold text-[var(--color-text)] border-b border-[var(--color-border)] text-center hidden sm:table-cell">Factor</th>
          <th scope="col" class="px-2 sm:px-3 py-2 font-semibold text-[var(--color-text)] border-b border-[var(--color-border)] text-center w-24">Horas</th>
          <th scope="col" class="px-2 sm:px-3 py-2 font-semibold text-[var(--color-text)] border-b border-[var(--color-border)] text-right">Monto</th>
        </tr>
      </thead>
      {/* Cada grupo se despliega por separado; solo el primero abre al cargar. Las horas de un
          grupo cerrado siguen contando y el encabezado lo avisa. */}
      {OVERTIME_GROUPS.map((group, gi) => {
        const codes = JSON.stringify(group.rows.map((r) => r.code));
        return (
        <tbody>
          <tr>
            <th scope="colgroup" colspan="4" class="p-0 bg-[rgba(20,158,201,0.14)]">
              <button
                type="button"
                aria-expanded={gi === 0 ? 'true' : 'false'}
                x-bind:aria-expanded={`abiertos[${gi}] ? 'true' : 'false'`}
                x-on:click={`abiertos[${gi}] = !abiertos[${gi}]`}
                class="w-full min-h-11 flex items-center gap-2 px-2 sm:px-3 py-2 text-left text-xs font-bold uppercase tracking-wide text-[var(--color-text)] -outline-offset-2 hover:bg-[rgba(20,158,201,0.10)]"
              >
                <svg
                  x-bind:class={`abiertos[${gi}] ? 'rotate-90' : ''`}
                  class={`w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[var(--color-primary-2)] ${gi === 0 ? 'rotate-90' : ''}`}
                  fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span class="flex-1">{group.title}</span>
                <span
                  class="normal-case tracking-normal font-medium text-[var(--color-accent-text)]"
                  x-show={`!abiertos[${gi}] && horasEnGrupo(${codes}) > 0`}
                  x-text={`horasEnGrupo(${codes}) + ' h'`}
                  style="display:none;"
                ></span>
              </button>
            </th>
          </tr>
          {group.rows.map((row) => (
            <tr class="hover:bg-[rgba(20,158,201,0.05)]" x-show={`abiertos[${gi}]`} style={gi === 0 ? undefined : 'display:none;'}>
              <td class="px-2 sm:px-3 py-2 text-[var(--color-text)] border-b border-[var(--color-border)]">
                <label for={`ot-${row.code}`}>{row.label}</label>
                <span class="sm:hidden block text-xs font-mono text-[var(--color-muted)]">×{formatFactor(row.factor)}</span>
              </td>
              <td class="px-2 sm:px-3 py-2 text-center font-mono text-[var(--color-muted)] border-b border-[var(--color-border)] hidden sm:table-cell">×{formatFactor(row.factor)}</td>
              <td class="px-2 sm:px-3 py-2 border-b border-[var(--color-border)]">
                <input id={`ot-${row.code}`} x-model={`horas.${row.code}`} type="number" inputmode="decimal" min="0" step="0.5" placeholder="0" class="field field-sm" />
              </td>
              <td class="px-2 sm:px-3 py-2 text-right font-mono whitespace-nowrap text-[var(--color-text)] border-b border-[var(--color-border)]" x-text={`celda('${row.code}')`}>—</td>
            </tr>
          ))}
        </tbody>
        );
      })}
    </table>
  </div>

  <div class="space-y-2">
    <button type="button" x-on:click="calcular()" class="btn btn-primary">Calcular total sobretiempos</button>
    <p class="calc-error" role="alert" x-show="error" x-text="error" style="display:none;"></p>
  </div>

  <div x-show="resultado" x-transition class="result space-y-3" style="display:none;" aria-live="polite">
    <h3 class="result-title">Resumen de Sobretiempos</h3>
    <p class="text-sm text-[var(--color-muted)]">
      Salario/hora: <span class="font-mono font-semibold text-[var(--color-text)]" x-text="'B/. ' + (resultado?.salarioHora ?? 0).toFixed(4)"></span>
      <span class="text-xs text-[var(--color-accent-text)] font-medium ml-1">(208 h mensuales — jornada 6×1)</span>
    </p>
    <div class="space-y-1 text-sm">
      <template x-for="l in (resultado?.lineas ?? [])" x-bind:key="l.code">
        <div class="flex justify-between gap-4">
          <span class="text-[var(--color-muted)]" x-text="l.label + ' (' + l.hrs + ' h × ' + factor(l.factor) + '):'"></span>
          <span class="font-mono whitespace-nowrap text-[var(--color-text)]" x-text="$money(l.monto)"></span>
        </div>
      </template>
    </div>
    <div class="result-divider pt-3 flex flex-wrap justify-between items-center gap-x-4">
      <span class="result-total-label">Total sobretiempos:</span>
      <span class="result-total text-2xl" x-text="$money(resultado?.total)"></span>
    </div>
    <p class="disclaimer">
      <strong>Referencia orientativa.</strong> Este cálculo tiene como objetivo brindar una referencia de cómo se obtienen los montos, pero el valor real siempre estará sujeto a la realidad particular de cada empleado.
    </p>
  </div>
</div>
