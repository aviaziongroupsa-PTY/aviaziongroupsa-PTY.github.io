---
interface Props {
  email: string;
}
const { email } = Astro.props;
---

<footer class="bg-[var(--color-primary-dark)] border-t border-[var(--color-border)]">
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <div class="py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-center">
      <p class="text-xs text-[var(--color-muted)]">
        © <span x-data="currentYear" x-text="year">{new Date().getFullYear()}</span> Aviazion Group — Todos los derechos reservados
      </p>
      <a href={`mailto:${email}`} class="text-sm py-2 text-[var(--color-primary-2)] hover:text-white underline underline-offset-4 transition-colors duration-200">{email}</a>
    </div>
  </div>
</footer>
