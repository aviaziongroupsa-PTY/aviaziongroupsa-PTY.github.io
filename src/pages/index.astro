---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import QuickLinks from '../components/sections/QuickLinks.astro';
import Calculators from '../components/sections/Calculators.astro';
import FAQ from '../components/sections/FAQ.astro';
import rawContent from '../../content/content.json';
import type { SiteContent } from '../lib/types';

const content: SiteContent = rawContent;
---

<BaseLayout title={content.site.name} description={content.site.tagline}>
  <Header symbol={content.site.symbolUrl} />
  <main id="main-content">
    <Hero site={content.site} />
    <QuickLinks links={content.quickLinks} />
    <Calculators />
    <FAQ items={content.faq} />
  </main>
  <Footer email={content.site.contactEmail} />
</BaseLayout>
